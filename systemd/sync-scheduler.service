[Unit]
Description=rclone-sync per-pair scheduler tick
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=rclone-sync
Group=rclone-sync
WorkingDirectory=/opt/rclone-sync
UMask=0077
Environment="PATH=/opt/rclone-sync/venv/bin:/usr/bin:/bin"
Environment="RCLONE_SYNC_CONFIG=/opt/rclone-sync/data/config.yaml"
Environment="RCLONE_SYNC_DB=/opt/rclone-sync/data/rclone-sync.db"
Environment="RCLONE_SYNC_STATE_DIR=/opt/rclone-sync/data/runtime"
Environment="RCLONE_CACHE_DIR=/opt/rclone-sync/data/.rclone-cache"
Environment="RCLONE_CONFIG=/home/rclone-sync/.config/rclone/rclone.conf"
Environment="RCLONE_ASK_PASSWORD=false"
ExecStartPre=/bin/mkdir -p /opt/rclone-sync/data/.rclone-cache /opt/rclone-sync/data/runtime /opt/rclone-sync/logs /opt/rclone-sync/temp
ExecStart=/opt/rclone-sync/venv/bin/python -m app.jobs.scheduler_cli
TimeoutStartSec=14400
TimeoutStopSec=30
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/opt/rclone-sync/data /opt/rclone-sync/logs /opt/rclone-sync/temp /home/rclone-sync/.config/rclone /mnt /media /srv
ProtectKernelLogs=true
ProtectProc=invisible
RestrictRealtime=true
RestrictNamespaces=true
SystemCallArchitectures=native
MemoryDenyWriteExecute=true
RemoveIPC=true
KeyringMode=private
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
ProtectClock=true
ProtectHostname=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
LockPersonality=true
RestrictSUIDSGID=true
CapabilityBoundingSet=
AmbientCapabilities=
