[Unit]
Description=rclone-sync Per-Pair-Schedule Tick
After=network-online.target rclone-sync-web.service

[Service]
Type=oneshot
User=rclone-sync
Group=rclone-sync
WorkingDirectory=/opt/rclone-sync
Environment="PATH=/opt/rclone-sync/venv/bin:/usr/bin:/bin"
Environment="SCRAPPER_CONFIG=/opt/rclone-sync/data/config.yaml"
Environment="RCLONE_CACHE_DIR=/opt/rclone-sync/data/.rclone-cache"
ExecStartPre=/bin/mkdir -p /opt/rclone-sync/data/.rclone-cache
ExecStartPre=/bin/chown rclone-sync:rclone-sync /opt/rclone-sync/data/.rclone-cache
# Sehr kurzes Timeout - der Scheduler-Tick selbst ist schnell, nur wenn
# tatsächlich Pairs zu syncen sind wird's länger (bis 4h pro Pair)
ExecStart=/opt/rclone-sync/venv/bin/python -m app.jobs.scheduler_cli
TimeoutStartSec=14400
